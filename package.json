{
  "name": "@mskalski/drafts-mcp",
  "version": "0.3.0",
  "description": "MCP server bridging Claude/Codex/Cursor to the Drafts app on macOS — create, search, append, and run actions on your drafts by chatting.",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "drafts-mcp": "build/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --experimental-vm-modules --experimental-global-customevent --localstorage-file=/tmp/jest-localstorage node_modules/.bin/jest --testTimeout=40000",
    "test:watch": "node --experimental-vm-modules --experimental-global-customevent --localstorage-file=/tmp/jest-localstorage node_modules/.bin/jest --watch",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "mcpb": "node scripts/build-mcpb.mjs",
    "binary": "node scripts/build-binary.mjs",
    "version:check": "node scripts/bump-version.mjs --check",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "drafts",
    "drafts-app",
    "notes",
    "macos",
    "claude",
    "codex",
    "cursor"
  ],
  "author": "Marcin Skalski",
  "license": "MIT",
  "homepage": "https://github.com/Automaat/drafts-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Automaat/drafts-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Automaat/drafts-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.0"
  }
}
